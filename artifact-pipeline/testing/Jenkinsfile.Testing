// feature branch

pipeline {
    agent any

    environment {
            BRANCH_NAME = null
            TESTING_CHECK_SUCCESS = null

            SCANNER_HOME = tool 'Sonar-scanner'
            // SONARQUBE_SCANNER_VERSION = '4.6.2.2472' // Update with the latest version
            SONARQUBE_HOST = 'http://localhost:5000' // Update with your SonarQube server URL
            SONARQUBE_PROJECT_KEY = 'demo-nodejs'

            NODE_VERSION = '14'
            APP_NAME = 'castV'
            DOCKER_REGISTRY = 'your-docker-registry'
            DOCKER_IMAGE_NAME = "${DOCKER_REGISTRY}/${APP_NAME}"
            DOCKER_IMAGE_TAG = "${DOCKER_IMAGE_NAME}:${semverMajorMinor()}-${env.BUILD_NUMBER}"
        
            }

    stages {
        stage('Checkout') {
            steps {
                // Checkout your Node.js project from version control
                checkout scm
            }
        }
        stage('Conditional Stage  ') {
             when {
                expression { return env.BRANCH_NAME =~ /^testing\/\d+$/ || env.COMMIT_MESSAGE =~ /testing/ }
            }
            steps {
                script {
                    echo 'Setting BRANCH_NAME to testing'
                    BRANCH_NAME = 'testing'
                }
            }
        }
        stage('Run Unit Tests') {
            when {
                expression { return BRANCH_NAME == 'testing' }
            }
            steps {
                script {
                    // Run Node.js unit tests
                    sh "npm install"
                    sh "npm test"
                    // Publish JUnit test results
                    junit '**/test-results.xml'
                }
            }
        }
        stage('Run Integration Test ') {
            when {
                expression { return BRANCH_NAME == 'testing' }
            }
            steps {
                // Start your application (assuming it's running on localhost:3000)
                sh 'npm start &'

                // Run Puppeteer-based E2E tests
                sh 'npm run test:integrated'
            }
        }
        stage('Run E2E Tests') {
            when {
                expression { return BRANCH_NAME == 'testing' }
            }
            steps {
                // Start your application (assuming it's running on localhost:3000)
                sh 'npm start &'

                // Run Puppeteer-based E2E tests
                sh 'npm run test:e2e'
                TESTING_CHECK_SUCCESS = true
            }
        }
        stage('Create a Release x branch for testing x') {
            when {
                expression { return BRANCH_NAME == 'feature' &&  TESTING_CHECK_SUCCESS == true  }
            }
            steps {
                // Your build steps go here
                echo 'creating and commit Release branch '
            }
        }
        
    }
    post {
        success {
            echo 'Pipeline succeeded!'
        }
        failure {
            echo 'Pipeline failed!'
        }
        always {

            // Cleanup or post-build actions go here
            // Stop your application after tests
            sh 'pkill -f "node your-app.js"'
            echo 'Pipeline completed!'

        }
    }
}
